# Copy this file to `.env.local` (already gitignored) and fill in real values
# from the shared Supabase project: Project Settings -> API.
#
# VITE_SUPABASE_URL: the "Project URL" field.
# VITE_SUPABASE_ANON_KEY: the "anon" "public" key field.
#
# Never put the "service_role" key here or anywhere else in the client app —
# it must never reach the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
